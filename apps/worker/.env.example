# Copy to apps/worker/.env for local runs (git-ignored); export the variables or use `node --env-file`.
NODE_ENV=development
# Same database as the api (the api owns the schema). Local disposable database only.
DATABASE_URL=postgres://equipdemo:change-me@127.0.0.1:5432/equipdemo
POLL_INTERVAL_MS=1000
BATCH_SIZE=10
LEASE_MS=30000
MAX_ATTEMPTS=5
