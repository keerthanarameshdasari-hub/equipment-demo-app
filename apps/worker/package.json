{
  "name": "@equipdemo/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Outbox worker: delivers events written by the api (at-least-once, leased claims, exponential backoff, dead-letter).",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "knex": "3.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@equipdemo/config": "*",
    "@equipdemo/contracts": "*",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
