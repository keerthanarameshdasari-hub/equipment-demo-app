{
  "name": "@equipdemo/api",
  "version": "0.1.0",
  "private": true,
  "description": "Equipment HTTP API (Fastify 5, PostgreSQL via Knex). Owns the database schema and writes outbox events for the worker.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "migrate": "tsx src/migrate.ts",
    "migrate:dist": "node dist/migrate.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "build": "node build.mjs"
  },
  "dependencies": {
    "@fastify/cors": "11.3.1",
    "@fastify/rate-limit": "10.3.0",
    "fastify": "5.12.5",
    "knex": "3.3.0",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@equipdemo/config": "*",
    "@equipdemo/contracts": "*",
    "@types/node": "^22.10.0",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "^5.8.3",
    "vitest": "3.2.7"
  }
}
