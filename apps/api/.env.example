# Copy to apps/api/.env for local runs (git-ignored). The api does NOT read .env files itself:
# export the variables, or use `node --env-file=.env` / your platform's secret mechanism.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Local disposable database only (see infra/compose.yaml). Never commit real credentials.
DATABASE_URL=postgres://equipdemo:change-me@127.0.0.1:5432/equipdemo
RATE_LIMIT_MAX=100
# Comma-separated browser origins allowed to call the API (admin-web dev server).
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
